@page "/posteingang"
@page "/"
@inject MailService MailService




<MudStack Spacing="3">

    <!-- Header -->
    <MudStack Row="true" AlignItems="AlignItems.Center">

        <MudText Typo="Typo.h4">
            Posteingang
        </MudText>

        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       OnClick="Refresh"
                       Color="Color.Primary"
                       Disabled="@(MailService.CurrentAccount == null)" />

    </MudStack>


    <!-- Account Info -->
    @if (MailService.CurrentAccount != null)
    {
        
            
        <MudText Typo="Typo.caption"
                 Color="Color.Secondary">

            Verbunden mit:
            @MailService.CurrentAccount.Email
               
        </MudText>
        <MudStack Row="true"
                  Style="width:100%"
                  AlignItems="AlignItems.Center">
            <MudCheckBox T="bool"
                         Value="@AllSelected"
                         ValueChanged="SelectAll"/>
            <MudIconButton Icon="@Icons.Material.Filled.DeleteForever"
                           Color="Color.Error"
                           OnClick="() => DeleteSelected()"/>
        </MudStack>
    }
    <!-- Inhalt -->
    <MudPaper Elevation="2" Class="rounded-xl">
        @if (bIsLoading)
        {
            <MudStack Class="pa-8"
                      AlignItems="AlignItems.Center"
                      Spacing="2">
            <MudText>Loading...</MudText>
            </MudStack>
        }
        
        else if (MailService.CurrentAccount == null)
        {
            <!-- Kein Login -->
            <MudStack Class="pa-8"
                      AlignItems="AlignItems.Center"
                      Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle"
                         Size="Size.Large"/>
                <MudText Typo="Typo.h6">
                    Kein Konto verbunden
                </MudText>
                <MudText Color="Color.Secondary"
                         Align="Align.Center">
                    Bitte melde dich zuerst an,
                    um deine E-Mails zu sehen.
                </MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="/login"
                           StartIcon="@Icons.Material.Filled.Login">
                    Zum Login
                </MudButton>
            </MudStack>
        }
        else if (_emails.Count == 0)
        {
            <!-- Keine Mails -->
            <MudStack Class="pa-8"
                      AlignItems="AlignItems.Center"
                      Spacing="2">

                <MudIcon Icon="@Icons.Material.Filled.Inbox"
                         Size="Size.Large"/>
                <MudText>
                    Keine E-Mails vorhanden
                </MudText>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadEmails">
                    Aktualisieren
                </MudButton>
            </MudStack>
        }
        else
        {
            <!-- Mail Liste -->
            @foreach (var mail in _emails)
            {

                <MudPaper Class="pa-2">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center">
                        <MudCheckBox T="bool"
                                     Value="@SelectedMails.Contains(mail)"
                                     ValueChanged="@(x => ToggleSelection(mail, x))"
                                     @onmousedown:stopPropagation="true"/>
                        <MudButton FullWidth="true"
                                   Class="mail-item"
                                   Style="@GetMailStyle(mail)"
                                   OnClick="() => OpenMail(mail)">
                            <MudStack Row="true"
                                      Style="width:100%;"
                                      AlignItems="AlignItems.Center">
                                <!-- Ungelesen-Indikator -->
                                <div style="width:20px;display:flex;justify-content:center;">
                                    @if (!mail.IsRead)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Circle"
                                                 Size="Size.Small"
                                                 Color="Color.Primary"/>
                                    }
                                </div>
                                <MudAvatar Color="@(mail.IsRead ? Color.Default : Color.Primary)">
                                    @mail.Initials
                                </MudAvatar>
                                <MudStack Spacing="0"
                                          Style="flex:1;text-align:left;"
                                          Class="ml-3">
                                    <MudText Typo="@(mail.IsRead ? Typo.body1 : Typo.subtitle1)"
                                             Style="@(mail.IsRead ? "" : "font-weight:700;")">
                                        @mail.Subject
                                    </MudText>
                                    <MudText Typo="Typo.caption"
                                             Style="@(mail.IsRead ? "" : "font-weight:600;")"
                                             Color="Color.Secondary">
                                        @mail.Sender
                                    </MudText>
                                </MudStack>
                                <MudText Typo="Typo.caption"
                                         Style="@(mail.IsRead ? "" : "font-weight:700;")">
                                    @mail.Date.ToShortDateString()
                                </MudText>
                            </MudStack>
                        </MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="() => DeleteMail(mail)"/>
                    </MudStack>
                </MudPaper>
                <MudDivider/>
            }
        }
    </MudPaper>
</MudStack>

<MudMessageBox @ref="_mudMessageBox" Title="Warnung" CancelText="Abbrechen">
    <MessageContent>
        Möchtest du die Mails in den Papierkorb verschieben?
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever">Verschieben</MudButton>
    </YesButton>
</MudMessageBox>

@inject ISnackbar Snackbar
@using LightMail.Services
@implements IDisposable
@code {

    public async void Refresh()
    {
        await LoadEmails();
        StateHasChanged();
        Snackbar.Add(
          "Emails wurden aktualisiert!",
            Severity.Success);
    }
    
    private MudMessageBox _mudMessageBox;
    private async void DeleteSelected()
    {
        bool? result = await _mudMessageBox.ShowAsync();
        if (result == true)
        {
            int num = SelectedMails.Count;
            _emails.RemoveAll(x => SelectedMails.Contains(x));
            StateHasChanged();
            
            await MailService.MoveToTrashAsync(SelectedMails.ToList());
            SelectedMails.Clear();
            Snackbar.Add(
                $"{num} E-Mail{(num > 1 ? "s" : "")} wurde{(num > 1 ? "n" : "")} in den Papierkorb verschoben",
                Severity.Success);
        }
    }
    
    private void ToggleSelection(
        Posteingang.EmailPreview mail,
        bool selected)
    {
        if(selected)
            SelectedMails.Add(mail);
        else
            SelectedMails.Remove(mail);
    }
    
    private void SelectAll(bool selected)
    {
        if(selected)
        {
            foreach(var mail in _emails)
            {
                SelectedMails.Add(mail);
            }
        }
        else
        {
            SelectedMails.Clear();
        }
    }
    
    private List<EmailPreview> _emails = new();
    
    private HashSet<EmailPreview> SelectedMails = new();
    private bool AllSelected =>
        _emails.Count > 0 &&
        SelectedMails.Count == _emails.Count;
    
    private bool bIsLoading = false;
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            MailService.SearchChanged += SearchChanged;
            bIsLoading = true;
            await MailService.AutoLoginAsync();
            bIsLoading = false;
            await LoadEmails();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
    
    public void Dispose()
    {
        MailService.SearchChanged -= SearchChanged;
    }

    private string GetMailStyle(EmailPreview mail)
    {
        if (mail.IsRead)
            return "";

        return "background-color: rgba(33,150,243,0.08);";
    }

    public void SearchChanged()
    {
        string search = MailService.searchTerm?.Trim().ToLower() ?? "";

        if (string.IsNullOrWhiteSpace(search))
        {
            _emails = _emails
                .OrderByDescending(x => x.Date)
                .ToList();

            InvokeAsync(StateHasChanged);
            return;
        }

        _emails = _emails
            .OrderBy(x =>
            {
                string subject = x.Subject?.ToLower() ?? "";
                string sender = x.Sender?.ToLower() ?? "";

                if (subject == search) return 0;
                if (subject.StartsWith(search)) return 1;
                if (subject.Contains(search)) return 2;

                if (sender.StartsWith(search)) return 3;
                if (sender.Contains(search)) return 4;

                return 5;
            })
            .ThenByDescending(x => x.Date)
            .ToList();

        InvokeAsync(StateHasChanged);
    }

    private async Task LoadEmails()
    {
        if (MailService.CurrentAccount == null)
        {
            _emails.Clear();
            return;
        }


        _emails = await MailService.GetInboxAsync();
        SearchChanged();
    }


    [Inject]
    NavigationManager Navigation {get;set;} = default!;

    private void OpenMail(EmailPreview mail)
    {
        Navigation.NavigateTo($"/mail/{mail.Folder}/{mail.Id.ToString()}");
    }

    public class EmailPreview
    {
        public MailKit.UniqueId Id { get; set; }

        public string Folder { get; set; } = "Inbox";

        public string Sender { get; set; } = "";

        public string Subject { get; set; } = "";

        public DateTime Date { get; set; }

        public bool IsRead { get; set; }


        public string Initials =>
            string.Join("",
                    Sender.Split(' ')
                        .Where(x => !string.IsNullOrEmpty(x))
                        .Select(x => x[0]))
                .ToUpper();
    }
    
    private async void  DeleteMail(EmailPreview mail)
    {
        if (!_emails.Contains(mail))
            return;
        
        // clients predict the remove
        _emails.Remove(mail);
        StateHasChanged();
        
        await MailService.MoveToTrashAsync(mail);
        
        Snackbar.Add(
            "E-Mail wurde in den Papierkorb verschoben",
            Severity.Success);
    }

}